# Supabase project configuration
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only: required for admin operations such as validating bearer tokens and user management.
# Never expose or prefix this with EXPO_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# CORS allowlist: comma-separated exact browser origins (scheme://host[:port]) that may
# call the API with credentials. Required in production; empty = credentialed browser
# CORS denied (fail closed). Localhost/127.0.0.1 are auto-allowed in non-production only.
ALLOWED_ORIGINS=https://app.example.com
